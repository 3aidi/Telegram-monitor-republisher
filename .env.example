# ============================================================
# Telegram Channel Monitor & Auto-Republisher - environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================

# --- Telegram credentials (REQUIRED) -------------------------
# Get API_ID/API_HASH at https://my.telegram.org (API development tools)
API_ID=0
API_HASH=
# Destination channel to republish into (@username or numeric id)
DEST_CHANNEL=
# Bot token from @BotFather (admin approval bot). Optional but recommended.
BOT_TOKEN=
# Your numeric Telegram user id (admin who receives approvals/alerts)
ADMIN_USER_ID=0
# Username shown in the "Order" footer line of every published post
CONTACT_USERNAME=

# --- Sources (REQUIRED) --------------------------------------
# Comma-separated list of supplier channels to monitor
# (@usernames or -100... numeric ids). Managed later via the admin bot.
SOURCE_CHANNELS=

# --- AI (Groq) -----------------------------------------------
# Key from https://console.groq.com — enables AI analysis/rephrasing.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.8
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT=45
GROQ_MAX_RETRIES=3
GROQ_MAX_CONCURRENCY=2

# --- AI fallback (OpenRouter :free, optional) ----------------
# Zero-cost safety net when Groq rate-limits/times out.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TIMEOUT=30
OPENROUTER_COOLDOWN_SECONDS=60

# --- Behavior tuning (defaults shown) ------------------------
# Re-process messages missed while the bot was down (1 = on)
BACKFILL_ON_START=0
# Seconds between destination publishes (rate limit safety)
PUBLISH_INTERVAL=1.5
# Publish retry attempts before a listing goes to the failed queue
PUBLISH_MAX_RETRIES=4
# Hours a duplicate listing stays blocked (content fingerprint + price)
DEDUP_HOURS=8
# Minutes an admin REJECTION keeps blocking the same content. Rejecting a post
# used to erase it from dedup memory, letting the next identical copy publish.
REJECT_MEMORY_MINUTES=180
# Seconds a listing is held before any decision is made. A burst of identical
# re-posts must all be present before the first one is decided, otherwise the
# first publishes before its twins arrive. Adds this much latency per post.
QUARANTINE_SECONDS=100
# Hours an AI analysis result stays cached (saves free-tier quota)
AI_CACHE_TTL_HOURS=48
# Skip obvious non-listings before calling the AI (saves quota)
PRE_FILTER_CHATTER=1
# Publish real listings via the regex path when the AI is fully down
DETERMINISTIC_FALLBACK=1

# --- Destination forwarding --------------------------------
# Seconds to wait between forwarding one post to each destination. With many
# destinations a single account can trip Telegram's flood limit, which shows up
# as confusing "message ID is invalid" errors rather than a clean throttle.
# 23 destinations at 2s produced ~270 FloodWaits/hour; 5s is the safe default.
FORWARD_PACING_SECONDS=5.0
# How long ONE destination may sleep on a flood wait before it is deferred to
# the back of the queue.
FORWARD_FLOODWAIT_BUDGET_SECONDS=60
# Ceiling on that deferral. A flood wait asks for hours; the row just waits and
# is NOT charged a retry, so throttling can never mark a healthy destination
# dead. Set to 0 to disable the daily destination-health DM.
FORWARD_FLOODWAIT_MAX_DEFERRAL_SECONDS=3600

# --- Storage -------------------------------------------------
# SQLite database file path (default: monitor.db)
DB_PATH=monitor.db